# Normalise line endings so a Windows dev box and the hospital Linux boxes
# produce identical diffs. Without this, every commit warns and every
# cross-platform diff shows whole-file churn.

* text=auto eol=lf

# Windows-only tooling that must keep CRLF
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Never touch these
*.png   binary
*.jpg   binary
*.pdf   binary
*.parquet binary
*.duckdb binary

# extrct deploy secrets. Copy to `.env` (gitignored) or just run `.\bootstrap.ps1`,
# which generates this file with real random values.
#
# Every variable below has a working default in the compose files, so the stack boots
# without a .env — but the Langfuse defaults are upstream placeholders (`mysalt`, an
# all-zero encryption key). Do not leave them in place.

# --- core: System DB registries -------------------------------------------------
EXTRCT_DB_USER=extrct
EXTRCT_DB_PASSWORD=
EXTRCT_DB_NAME=extrct

# --- core: Label Studio ---------------------------------------------------------
LABEL_STUDIO_USERNAME=admin@extrct.local
LABEL_STUDIO_PASSWORD=

# --- Langfuse -------------------------------------------------------------------
NEXTAUTH_URL=http://localhost:3000
LANGFUSE_NEXTAUTH_SECRET=          # 32+ random bytes
LANGFUSE_SALT=                     # 32+ random bytes
LANGFUSE_ENCRYPTION_KEY=           # EXACTLY 64 hex chars (32 bytes)
LANGFUSE_DB_PASSWORD=
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=
REDIS_AUTH=

# --- Langflow (prototype profile) -----------------------------------------------
LANGFLOW_SUPERUSER=admin
LANGFLOW_SUPERUSER_PASSWORD=
LANGFLOW_DB_PASSWORD=

# Filled in AFTER first boot: create a project in the Langfuse UI (http://localhost:3000),
# copy its API keys here, then `docker compose --profile prototype up -d` to restart
# Langflow with tracing wired up.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

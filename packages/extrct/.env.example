# extrct environment — copy to .env and fill in what you use.
# Credentials NEVER go into YAML configs or *-def documents; they are resolved
# from the environment at send time only (see docs/configuration.md).

# --- OpenRouter -------------------------------------------------------------
# Create a key at https://openrouter.ai/keys. Consider a per-project key with a
# spend limit so cost stays attributable.
OPENROUTER_API_KEY=

# Optional: route OpenRouter traffic through your own egress gateway/proxy.
# When set, clients built from definitions use it automatically; when empty,
# direct egress is used (and recorded as such on every run row).
EXTRCT_GATEWAY_URL=

# --- Run log ----------------------------------------------------------------
# Postgres DSN for the run log (only needed for the postgres storage backend).
# Example: postgresql://extrct:secret@127.0.0.1:5432/extrct
EXTRCT_PG_DSN=

# --- Ollama -----------------------------------------------------------------
# No key needed. The base_url lives in the YAML client config
# (default http://localhost:11434).

# --- Live traces (optional; needs `pip install "extrct[otel]" opentelemetry-sdk`
#     plus an OTLP exporter) --------------------------------------------------
# Example: self-hosted Langfuse >= 3.22 (OTLP over HTTP; auth is base64(pk:sk)):
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:3000/api/public/otel/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS="Authorization=Basic <base64(public_key:secret_key)>"
